ADMIN_PASSWORD=assay
AUTH_SECRET=change-this-secret-in-production
SITE_URL=http://localhost:3000
MAIL_FROM=The Abyss <onboarding@resend.dev>
# RESEND_API_KEY=

# Data backend. Local development can stay on Blob; production is set to "neon" in Vercel.
# Neon access uses the Vercel production OIDC identity through the Neon Data API.
DATA_BACKEND=blob
NEON_DATA_API_URL=https://ep-steep-salad-b7nhnbdu.apirest.c-13.us-east-1.aws.neon.tech/the_abyss/rest/v1

# Media remains independently switchable. Keep Blob until every asset is copied and verified in Neon Object Storage.
MEDIA_BACKEND=blob

# Optional direct Neon connection for local/admin migration scripts only. Do not commit a real value.
DATABASE_URL=

# Neon Object Storage (S3-compatible). Store secrets only in Vercel environment variables or .env.local.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
NEON_STORAGE_BUCKET=the-abyss-media

# Existing Vercel Blob stores remain the media backend and rollback source during the staged cutover.
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=

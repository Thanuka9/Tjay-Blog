ADMIN_PASSWORD=assay
AUTH_SECRET=change-this-secret-in-production
SITE_URL=http://localhost:3000
MAIL_FROM=The Abyss <onboarding@resend.dev>
# RESEND_API_KEY=

# Backend switch. Keep "blob" until the Neon migration has been verified.
DATA_BACKEND=blob

# Media can switch independently so database migration does not change image/PDF behavior.
MEDIA_BACKEND=blob

# Neon Postgres. Store the real value only in Vercel environment variables or .env.local.
DATABASE_URL=

# Neon Object Storage (S3-compatible). Store secrets only in Vercel environment variables or .env.local.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
NEON_STORAGE_BUCKET=the-abyss-media

# Temporary migration/fallback credentials for the existing Vercel Blob stores.
# Remove these after the Neon cutover has been verified and the old Blob stores are retired.
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
